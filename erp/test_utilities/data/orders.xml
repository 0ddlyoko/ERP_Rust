<erp>
    <record id="main_order" model="sale_order">
        <name>Seeded order</name>
    </record>

    <record id="first_line" model="sale_order_line">
        <price>7</price>
        <amount>6</amount>
        <order ref="main_order"/>
    </record>

    <!-- The long form stays valid, and is what a field whose name collides with a structural
         element would use. -->
    <record id="reference_invoice" model="invoice" noupdate="1">
        <field name="name">Untouchable</field>
        <amount_untaxed>1234.56</amount_untaxed>
        <due_date>2026-09-30</due_date>
    </record>
</erp>
