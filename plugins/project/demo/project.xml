    <project_stage id="demo_stage_website_review" project="demo_project_website" name="Review" sequence="30"/>
    <project_stage id="demo_stage_website_done" project="demo_project_website" name="Done" sequence="40" is_closed="1" unlocks="1"/>

    <project_stage id="demo_stage_internal_todo" project="demo_project_internal" name="To do" sequence="10"/>
