    <project_stage id="demo_stage_migration_review" project="demo_project_migration" name="Review" sequence="30"/>
    <project_stage id="demo_stage_migration_done" project="demo_project_migration" name="Done" sequence="40" is_closed="1" unlocks="1"/>

    <project_stage id="demo_stage_website_todo" project="demo_project_website" name="To do" sequence="10"/>
