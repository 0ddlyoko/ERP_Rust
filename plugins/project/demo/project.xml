    <project_checklist_item id="demo_template_step_analytics" task="demo_template_task_launch" name="Set up the analytics" sequence="20"/>

    <project_task id="demo_task_kickoff" project="demo_project_migration" name="Kick-off meeting with the customer"
                  assignees="base.user_admin,demo_user_julie" planned_hours="2" date_deadline="2026-09-26" sequence="10"/>
    <project_task id="demo_task_mapping" project="demo_project_migration" name="Map the chart of accounts"
