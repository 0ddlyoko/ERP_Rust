    <project_stage id="demo_stage_internal_review" project="demo_project_internal" name="Review" sequence="30"/>
    <project_stage id="demo_stage_internal_done" project="demo_project_internal" name="Done" sequence="40" is_closed="1" unlocks="1"/>

    <project_stage id="demo_stage_template_website_todo" project="demo_template_website" name="To do" sequence="10"/>
    <project_stage id="demo_stage_template_website_progress" project="demo_template_website" name="In progress" sequence="20"/>
    <project_stage id="demo_stage_template_website_review" project="demo_template_website" name="Review" sequence="30"/>
    <project_stage id="demo_stage_template_website_done" project="demo_template_website" name="Done" sequence="40" is_closed="1" unlocks="1"/>

    <project_task id="demo_template_task_brief" project="demo_template_website" name="Gather the brief"
                  planned_hours="3" sequence="10"/>
    <project_task id="demo_template_task_design" project="demo_template_website" name="Design the pages"
                  tags="demo_tag_design" planned_hours="12" sequence="20" depends_on="demo_template_task_brief"/>
    <project_task id="demo_template_task_build" project="demo_template_website" name="Build the site"
                  planned_hours="20" sequence="30" depends_on="demo_template_task_design"/>
    <project_task id="demo_template_task_launch" project="demo_template_website" name="Launch"
                  priority="high" planned_hours="5" sequence="40" depends_on="demo_template_task_build"/>
