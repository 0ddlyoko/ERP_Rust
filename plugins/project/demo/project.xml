    <project_task id="demo_task_products" project="demo_project_migration" name="Migrate products and prices"
                  assignees="demo_user_thomas" tags="demo_tag_data" planned_hours="10" date_deadline="2026-10-12" sequence="40"/>
    <project_task id="demo_task_invoices" project="demo_project_migration" name="Open invoices and balances"
                  assignees="base.user_admin" tags="demo_tag_migration" priority="urgent" planned_hours="8"
                  date_deadline="2026-10-02" sequence="50"/>
    <project_task id="demo_task_training" project="demo_project_migration" name="Train the sales team"
                  depends_on="demo_task_products"
                  assignees="demo_user_julie" tags="demo_tag_training" planned_hours="6" date_deadline="2026-11-05" sequence="60"/>
    <project_task id="demo_task_golive" project="demo_project_migration" name="Go live"
                  depends_on="demo_task_customers,demo_task_products,demo_task_invoices"
                  assignees="base.user_admin,demo_user_thomas" planned_hours="4" date_deadline="2026-11-15" sequence="70"/>

    <project_task id="demo_task_wireframes" project="demo_project_website" name="Wireframes of the home page"
                  assignees="demo_user_julie" tags="demo_tag_design" planned_hours="8" date_deadline="2026-10-09" sequence="10"/>
    <project_task id="demo_task_palette" project="demo_project_website" name="Colours and fonts"
                  assignees="demo_user_julie" tags="demo_tag_design" planned_hours="4" sequence="20"/>
    <project_task id="demo_task_catalogue" project="demo_project_website" name="Online catalogue"
                  assignees="demo_user_thomas" priority="high" planned_hours="16" date_deadline="2026-11-20" sequence="30"/>
    <project_task id="demo_task_contact_form" project="demo_project_website" name="Contact form sends no mail"
                  assignees="demo_user_thomas" tags="demo_tag_bug" priority="urgent" planned_hours="2" sequence="40"/>

    <project_task id="demo_task_backup" project="demo_project_internal" name="Nightly backups of the server"
                  assignees="base.user_admin" planned_hours="3" sequence="10"/>
    <project_task id="demo_task_onboarding" project="demo_project_internal" name="Onboarding checklist for newcomers"
                  assignees="demo_user_julie" planned_hours="2" sequence="20"/>

    <function model="project_task" name="action_next_stage"
              ref="demo_task_kickoff,demo_task_mapping,demo_task_customers,demo_task_invoices,demo_task_wireframes,demo_task_palette,demo_task_customers_dedupe,demo_task_backup"/>
    <function model="project_task" name="action_next_stage"
              ref="demo_task_kickoff,demo_task_mapping,demo_task_palette,demo_task_customers_dedupe"/>
    <function model="project_task" name="action_next_stage" ref="demo_task_kickoff,demo_task_mapping,demo_task_palette,demo_task_customers_dedupe"/>
