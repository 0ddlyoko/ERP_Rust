<templates>
    <t t-name="mail.Chatter">
        <div class="o_chatter" t-ref="element">
            <div class="o_chatter_top">
                <h2 class="o_form_block_title">Messages</h2>
                <t t-if="info">
                    <div class="o_chatter_followers">
                        <button type="button" class="o_chatter_followers_button" t-att-aria-expanded="followersOpen ? 'true' : 'false'"
                                t-att-title="info.followers.length + ' following'" t-on-click="toggleFollowers">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                            {{ info.followers.length }}
                        </button>
                        <div t-if="followersOpen" class="o_chatter_followers_list">
                            <div t-foreach="info.followers" t-as="follower" t-key="follower.id" class="o_chatter_follower">
                                <div class="o_chatter_follower_row">
                                    <span class="o_chatter_avatar o_chatter_avatar_small" t-att-style="avatarOf(follower.contact[1])"
                                          aria-hidden="true">{{ initialsOf(follower.contact[1]) }}</span>
                                    <span class="o_chatter_follower_name">{{ follower.contact[1] }}</span>
                                    <button type="button" t-att-class="{ o_chatter_icon: true, active: choosing === follower.id }"
                                            title="What they follow" aria-label="What they follow"
                                            t-att-aria-expanded="choosing === follower.id ? 'true' : 'false'"
                                            t-on-click="() => choosing = choosing === follower.id ? null : follower.id">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
                                        </svg>
                                    </button>
                                    <button type="button" class="o_chatter_icon" title="Remove" t-att-aria-label="'Remove ' + follower.contact[1]"
                                            t-on-click="() => removeFollower(follower.id)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                                    </button>
                                </div>
                                <ul t-if="choosing === follower.id" class="o_chatter_subtypes">
                                    <li t-foreach="info.subtypes" t-as="subtype" t-key="subtype.id">
                                        <label>
                                            <input type="checkbox" t-att-checked="follower.subtypes.includes(subtype.id)"
                                                   t-on-change="() => toggleSubtype(follower, subtype.id)"/>
                                            {{ subtype.name }}
                                        </label>
                                    </li>
                                </ul>
                            </div>
                            <RecordSearch model="'contact'" exclude="followerContacts" onPick="addFollower"
                                          placeholder="'Add a follower…'"/>
                        </div>
                    </div>
                    <button type="button" t-att-class="{ o_chatter_follow: true, o_chatter_following: info.following }"
                            t-on-click="toggleFollow">
                        <span class="o_chatter_follow_on">{{ info.following ? "Following" : "Follow" }}</span>
                        <span t-if="info.following" class="o_chatter_follow_off">Unfollow</span>
                    </button>
                </t>
                <button type="button" class="o_chatter_icon o_chatter_place"
                        t-att-title="sidePlace.below ? 'Beside the form' : 'Under the form'"
                        t-att-aria-label="sidePlace.below ? 'Beside the form' : 'Under the form'" t-on-click="toggleBelow">
                    <svg t-if="sidePlace.below" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/>
                    </svg>
                    <svg t-else="" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 14h18"/>
                    </svg>
                </button>
            </div>

            <t t-if="props.record !== null">
                <div class="o_chatter_tabs" role="group" aria-label="Write">
                    <button type="button" t-att-class="{ o_chatter_tab: true, active: composing === 'message' }"
                            t-att-aria-pressed="composing === 'message' ? 'true' : 'false'" t-on-click="() => compose('message')">Send message</button>
                    <button type="button" t-att-class="{ o_chatter_tab: true, active: composing === 'note' }"
                            t-att-aria-pressed="composing === 'note' ? 'true' : 'false'" t-on-click="() => compose('note')">Log note</button>
                    <button type="button" t-att-class="{ o_chatter_tab: true, active: composing === 'activity' }"
                            t-att-aria-pressed="composing === 'activity' ? 'true' : 'false'" t-on-click="() => compose('activity')">Activity</button>
                </div>
                <div t-if="composing === 'activity'" class="o_chatter_composer o_chatter_planner">
                    <div class="o_chatter_kinds" role="group" aria-label="Kind">
                        <button t-foreach="kinds" t-as="kind" t-key="kind.id" type="button"
                                t-att-class="{ o_chatter_kind: true, active: planKind === kind.id }"
                                t-att-aria-pressed="planKind === kind.id ? 'true' : 'false'" t-on-click="() => pickKind(kind)">
                            <Icon name="kind.icon" size="14"/>{{ kind.name }}
                        </button>
                    </div>
                    <input class="o_input" type="text" placeholder="Summary, e.g. Discuss the proposal"
                           t-att-value="planSummary" t-on-input="(ev) => planSummary = ev.target.value"/>
                    <div class="o_chatter_plan_row">
                        <label class="o_chatter_plan_field">
                            <span>Due</span>
                            <input class="o_input" type="date" t-att-value="planDeadline"
                                   t-on-input="(ev) => planDeadline = ev.target.value"/>
                        </label>
                        <div class="o_chatter_plan_field">
                            <span>For</span>
                            <RecordSearch model="'users'" text="planAssignee ? planAssignee[1] : ''" onPick="pickAssignee"
                                          placeholder="'Someone…'"/>
                        </div>
                    </div>
                    <textarea class="o_input" rows="2" placeholder="Note" t-att-value="planNote"
                              t-on-input="(ev) => planNote = ev.target.value"/>
                    <div class="o_chatter_composer_foot">
                        <span class="o_chatter_audience">Planned for {{ planAssignee ? planAssignee[1] : 'nobody yet' }}.</span>
                        <button type="button" class="o_button_primary" t-att-disabled="planKind === null || !planDeadline ? 'disabled' : null"
                                t-on-click="schedule">Schedule</button>
                    </div>
                </div>
                <div t-if="composing" t-att-class="{ o_chatter_composer: true, o_chatter_composer_note: composing === 'note' }">
                    <textarea t-ref="box" class="o_input" rows="3" t-att-value="text"
                              t-att-placeholder="composing === 'note' ? 'Log an internal note… @ to mention someone' : 'Write to the followers… @ to mention someone'"
                              t-on-input="(ev) => type(ev)" t-on-keydown="(ev) => key(ev)"/>
                    <ul t-if="mentionQuery !== null &amp;&amp; mentionResults.length" class="o_chatter_mentions" role="listbox">
                        <li t-foreach="mentionResults" t-as="choice" t-key="choice.contact" role="option"
                            t-att-aria-selected="choice_index === mentionAt ? 'true' : 'false'"
                            t-att-class="{ active: choice_index === mentionAt }"
                            t-on-mousedown.prevent="() => mention(choice)">
                            <span class="o_chatter_avatar o_chatter_avatar_small" t-att-style="avatarOf(choice.name)"
                                  aria-hidden="true">{{ initialsOf(choice.name) }}</span>
                            {{ choice.name }}
                        </li>
                    </ul>
                    <div class="o_chatter_composer_foot">
                        <span class="o_chatter_audience">{{ audience }}</span>
                        <button type="button" class="o_button_primary" t-att-disabled="sending || !text.trim() ? 'disabled' : null"
                                t-on-click="send">{{ composing === 'note' ? 'Log' : 'Send' }}</button>
                    </div>
                </div>
            </t>

            <ul t-if="planned.length" class="o_chatter_planned" aria-label="Planned activities">
                <li t-foreach="planned" t-as="activity" t-key="activity.id"
                    t-att-class="'o_chatter_activity o_chatter_due_' + dueOf(activity.deadline).state">
                    <span class="o_chatter_activity_icon"><Icon name="activity.kind.icon" size="15"/></span>
                    <div class="o_chatter_activity_main">
                        <div class="o_chatter_activity_head">
                            <strong>{{ activity.kind.name }}</strong>
                            <span t-if="activity.summary">{{ activity.summary }}</span>
                        </div>
                        <div class="o_chatter_activity_meta">
                            <span class="o_chatter_activity_due">{{ dueOf(activity.deadline).text }}</span>
                            · {{ activity.assignee[1] }}
                        </div>
                        <p t-if="activity.note" class="o_chatter_activity_note">{{ activity.note }}</p>
                        <div t-if="finishing === activity.id" class="o_chatter_finish">
                            <input class="o_input" type="text" placeholder="What came of it?" t-att-value="feedback"
                                   t-on-input="(ev) => feedback = ev.target.value"
                                   t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; finish(activity)"/>
                            <button type="button" class="o_button_primary" t-on-click="() => finish(activity)">Done</button>
                        </div>
                    </div>
                    <div t-if="finishing !== activity.id" class="o_chatter_activity_actions">
                        <button type="button" class="o_chatter_icon" title="Done" aria-label="Mark done"
                                t-on-click="() => startFinish(activity)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                        </button>
                        <button type="button" class="o_chatter_icon" title="Cancel" aria-label="Cancel the activity"
                                t-on-click="() => cancelActivity(activity)">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
                                 stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                        </button>
                    </div>
                </li>
            </ul>
            <div t-if="props.record !== null" class="o_chatter_filters" role="group" aria-label="Show">
                <button t-foreach="[['all', 'All'], ['message', 'Messages'], ['note', 'Notes'], ['change', 'Changes']]" t-as="option"
                        t-key="option[0]" type="button" t-att-class="{ o_chatter_filter: true, active: shown === option[0] }"
                        t-att-aria-pressed="shown === option[0] ? 'true' : 'false'" t-on-click="() => show(option[0])">{{ option[1] }}</button>
            </div>
            <p t-if="props.record === null" class="o_chatter_empty">Messages will show once the record is saved.</p>
            <p t-elif="!thread.length" class="o_chatter_empty">No messages yet.</p>
            <ol t-else="" class="o_chatter_thread">
                <li t-foreach="thread" t-as="message" t-key="message.id"
                    t-att-data-message="message.id"
                    t-att-class="{ o_chatter_message: true, o_chatter_note: message.kind === 'note', o_chatter_pinged: mentionsMe(message), o_chatter_mine: isMine(message), o_chatter_flash: flashed === message.id }">
                    <span class="o_chatter_avatar" aria-hidden="true">{{ initialsOf(authorOf(message)) }}</span>
                    <div class="o_chatter_content">
                        <div class="o_chatter_head">
                            <span class="o_chatter_author">{{ authorOf(message) }}</span>
                            <span class="o_chatter_date">{{ whenOf(message) }}</span>
                            <span t-if="message.kind === 'note'" class="o_chatter_badge">Note</span>
                            <span t-if="message.mails.length" class="o_chatter_mails">
                                <button type="button" t-att-class="'o_chatter_mail_button o_chatter_mail_' + mailState(message)"
                                        t-att-title="'Sent by mail to ' + message.mails.length" t-att-aria-label="'Mails of this message'"
                                        t-att-aria-expanded="mailsOf === message.id ? 'true' : 'false'"
                                        t-on-click="(ev) => toggleMails(message, ev)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
                                    </svg>
                                </button>
                                <Portal t-if="mailsOf === message.id" target="'body'">
                                <div class="o_chatter_mail_backdrop" t-on-mousedown.self="() => mailsOf = null"/>
                                <ul class="o_chatter_mail_list" t-att-style="mailsPlace">
                                    <li t-foreach="message.mails" t-as="mail" t-key="mail_index" t-att-title="mail.error ?? null">
                                        <span class="o_chatter_mail_who">
                                            <strong>{{ mail.recipient ?? "—" }}</strong>
                                            <span>{{ mail.email ?? "no address" }}</span>
                                        </span>
                                        <span t-att-class="'o_chatter_mail_state o_chatter_mail_' + mail.state">
                                            {{ mail.state === 'sent' ? 'Sent' : mail.state === 'failed' ? 'Failed' : 'Outgoing' }}
                                        </span>
                                    </li>
                                </ul>
                                </Portal>
                            </span>
                        </div>
                        <p t-if="message.kind === 'comment' &amp;&amp; message.recipients.length" class="o_chatter_to">
                            To {{ recipientsOf(message) }}
                        </p>
                        <p t-if="message.kind === 'creation'" class="o_chatter_created">Created the record</p>
                        <p t-if="message.body" class="o_chatter_body"><t t-foreach="segmentsOf(message)" t-as="segment" t-key="segment_index"><span t-if="segment.mention" class="o_chatter_mention">{{ segment.text }}</span><t t-else="">{{ segment.text }}</t></t></p>
                        <ul t-if="message.changes.length" class="o_chatter_changes">
                            <li t-foreach="message.changes" t-as="change" t-key="change.field">
                                <span class="o_chatter_field">{{ change.label }}</span>
                                <t t-if="message.kind !== 'creation'">
                                    <span class="o_chatter_old">{{ change.old ?? "—" }}</span>
                                    <span class="o_chatter_arrow" aria-label="became">→</span>
                                </t>
                                <span class="o_chatter_new">{{ change.new ?? "—" }}</span>
                            </li>
                        </ul>
                    </div>
                </li>
                <li t-if="loadingMore" class="o_chatter_more">Loading older messages…</li>
            </ol>
        </div>
    </t>
</templates>
