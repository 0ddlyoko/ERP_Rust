<erp>
    <view id="view_plugin_list" name="plugin.list" model="plugin">
        <list>
            <buttons>
                <button name="install" type="method" string="Install"/>
            </buttons>
            <field name="name"/>
            <field name="category"/>
            <field name="installed_version"/>
            <field name="state"/>
        </list>
    </view>
    <view id="view_plugin_form" name="plugin.form" model="plugin">
        <form>
            <buttons>
                <button name="install" type="method" string="Install" invisible="state === 'installed'"/>
            </buttons>
            <block>
                <h1><field name="name" readonly="1"/></h1>
                <block string="About">
                    <field name="description" readonly="1"/>
                    <field name="category" readonly="1"/>
                    <field name="author" readonly="1"/>
                    <field name="website" readonly="1"/>
                </block>
                <block string="Versions">
                    <field name="installed_version" readonly="1"/>
                    <field name="latest_version" readonly="1"/>
                    <field name="demo_loaded" readonly="1"/>
                </block>
            </block>
            <side>
                <block string="Status">
                    <field name="state" widget="statusbar_durations" nolabel="1" readonly="1"/>
                </block>
                <chatter/>
            </side>
        </form>
    </view>
    <action id="action_plugins" name="Plugins" model="plugin" views="list,form"/>

    <view id="view_parameter_list" name="parameter.list" model="parameter">
        <list>
            <field name="key"/>
            <field name="value"/>
        </list>
    </view>
    <view id="view_parameter_form" name="parameter.form" model="parameter">
        <form>
            <block>
                <field name="key"/>
                <field name="value"/>
            </block>
        </form>
    </view>
    <action id="action_parameters" name="Parameters" model="parameter" views="list,form"/>

    <view id="view_settings_form" name="settings.form" model="settings">
        <form>
            <block>
                <h1>Settings</h1>
                <field name="name" invisible="1"/>
                <block string="Demo data">
                    <field name="demo_data"/>
                </block>
            </block>
        </form>
    </view>
    <action id="action_settings" name="General settings" model="settings" views="form" record="base.settings"/>

    <view id="view_view_list" name="view.list" model="view">
        <list>
            <field name="name"/>
            <field name="model"/>
            <field name="inherit"/>
            <field name="priority"/>
        </list>
    </view>
    <action id="action_views" name="Views" model="view" views="list,form"/>

    <view id="view_menu_list" name="menu.list" model="menu">
        <list>
            <field name="complete_name"/>
            <field name="parent"/>
            <field name="sequence"/>
            <field name="action"/>
        </list>
    </view>
    <action id="action_menus" name="Menus" model="menu" views="list,form"/>

    <view id="view_action_list" name="action.list" model="action">
        <list>
            <field name="name"/>
            <field name="model"/>
            <field name="views"/>
        </list>
    </view>
    <action id="action_actions" name="Actions" model="action" views="list,form"/>

    <view id="view_access_rule_list" name="access_rule.list" model="access_rule">
        <list>
            <field name="name"/>
            <field name="model"/>
            <field name="group"/>
        </list>
    </view>
    <action id="action_access_rules" name="Access rules" model="access_rule" views="list,form"/>
</erp>
