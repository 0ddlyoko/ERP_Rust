<erp>
    <!-- Administrators may do anything to every model base declares. -->
    <access_rule id="access_company_admin">
        <name>company: administrators</name>
        <model>company</model>
        <group ref="group_admin"/>
        <domain_read>[]</domain_read>
        <domain_create>[]</domain_create>
        <domain_write>[]</domain_write>
        <domain_delete>[]</domain_delete>
    </access_rule>
