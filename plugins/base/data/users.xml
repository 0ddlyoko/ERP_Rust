<erp>
    <record id="group_user" model="group">
        <name>User</name>
    </record>

    <record id="group_admin" model="group">
        <name>Administrator</name>
    </record>

    <!-- The password is left to post_init, which sets a default one only if the account has
         none. noupdate then keeps a later reload from touching the account. -->
    <record id="user_admin" model="users" noupdate="1">
        <login>admin</login>
        <name>Administrator</name>
        <active>true</active>
    </record>
</erp>
