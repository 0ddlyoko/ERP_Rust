<templates>
    <t t-name="web.WebClient">
        <div class="o_web_client" t-att-style="accentStyle">
            <Sidebar modules="tree ?? []" module="module" action="action" menu="route.menu ?? null"
                     compact="route.view === 'form'" onModule="switchTo" onOpen="open" onHome="goHome"/>
            <main class="o_content">
                <ErrorBoundary>
                    <t t-set-slot="fallback" t-slot-scope="failed">
                        <p class="o_view_error">{{ failed.error.message }}</p>
                    </t>
                    <ActionManager t-if="action" action="action" module="module?.name ?? ''"
                                   view="route.view" resId="route.id"/>
                    <Home t-elif="route.action === null" modules="tree ?? []" onOpen="open"/>
                    <p t-else="" class="o_no_action">Nothing to open.</p>
                </ErrorBoundary>
            </main>
            <NotificationCenter/>
            <LoadingIndicator/>
        </div>
    </t>
</templates>
