<templates>
    <t t-name="web.ActionManager">
        <section class="o_action">
            <header class="o_action_header">
                <nav class="o_breadcrumb" aria-label="Breadcrumb">
                    <t t-if="props.module"><span>{{ props.module }}</span><span aria-hidden="true">/</span></t>
                    <t t-if="isRecord || breadcrumb.trail.length">
                        <a href="#" class="o_breadcrumb_link" t-on-click.prevent="backToList">{{ rootAction }}</a>
                        <span aria-hidden="true">/</span>
                        <t t-foreach="breadcrumb.trail" t-as="crumb" t-key="crumb_index">
                            <a href="#" class="o_breadcrumb_link" t-on-click.prevent="() => backTo(crumb_index)">{{ crumb.name }}</a>
                            <span aria-hidden="true">/</span>
                        </t>
                        <span class="o_breadcrumb_current">{{ isRecord ? (breadcrumb.record ?? "") : props.action.name }}</span>
                    </t>
                    <span t-else="" class="o_breadcrumb_current">{{ props.action.name }}</span>
                </nav>
                <div t-if="!isRecord" class="o_action_title_row">
                    <h1 class="o_action_title">{{ props.action.name }}</h1>
                    <div t-if="switchable.length > 1" class="o_view_switcher" role="group" aria-label="Views">
                        <button t-foreach="switchable" t-as="option" t-key="option" type="button"
                                t-att-class="{ o_view_switch: true, active: option === kind }"
                                t-att-aria-pressed="option === kind ? 'true' : 'false'"
                                t-att-title="option === 'kanban' ? 'Kanban' : 'List'" t-on-click="() => switchTo(option)">
                            <svg t-if="option === 'kanban'" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                <rect x="3" y="4" width="5" height="16" rx="1"/><rect x="10" y="4" width="5" height="10" rx="1"/>
                                <rect x="17" y="4" width="4" height="13" rx="1"/>
                            </svg>
                            <svg t-else="" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </header>
            <div t-if="view &amp;&amp; besideList" class="o_split">
                <RecordStrip t-if="stripAction" t-key="stripKey" resModel="stripAction.model" domain="stripDomain"
                             embedded="true" action="stripAction" listRoute="stripRoute" selected="stripSelected"/>
                <div class="o_split_main">
                    <t t-if="isRecord">
                        <t t-component="view" t-key="viewKey" resModel="props.action.model" domain="domain"
                           defaults="props.action.defaults" resId="props.resId ?? undefined" besideList="true"/>
                    </t>
                    <t t-else="">
                        <t t-component="view" t-key="viewKey" resModel="props.action.model" domain="domain"
                           defaults="props.action.defaults"/>
                    </t>
                </div>
            </div>
            <t t-elif="view">
                <t t-component="view" t-key="viewKey" resModel="props.action.model"
                   domain="domain" defaults="props.action.defaults" resId="props.resId ?? undefined"/>
            </t>
            <p t-else="" class="o_view_error">No view can show {{ props.action.views.join(", ") }}.</p>
        </section>
    </t>
</templates>
