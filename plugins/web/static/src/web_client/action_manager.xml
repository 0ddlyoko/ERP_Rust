<templates>
    <t t-name="web.ActionManager">
        <section class="o_action">
            <header class="o_action_header">
                <nav class="o_breadcrumb" aria-label="Breadcrumb">
                    <t t-if="props.module"><span>{{ props.module }}</span><span aria-hidden="true">/</span></t>
                    <t t-if="isRecord">
                        <a href="#" class="o_breadcrumb_link" t-on-click.prevent="backToList">{{ rootAction }}</a>
                        <span aria-hidden="true">/</span>
                        <t t-foreach="breadcrumb.trail" t-as="crumb" t-key="crumb_index">
                            <a href="#" class="o_breadcrumb_link" t-on-click.prevent="() => backTo(crumb_index)">{{ crumb.name }}</a>
                            <span aria-hidden="true">/</span>
                        </t>
                        <span class="o_breadcrumb_current">{{ breadcrumb.record ?? "" }}</span>
                    </t>
                    <span t-else="" class="o_breadcrumb_current">{{ props.action.name }}</span>
                </nav>
                <h1 t-if="!isRecord" class="o_action_title">{{ props.action.name }}</h1>
            </header>
            <t t-if="view">
                <t t-component="view" t-key="viewKey" resModel="props.action.model"
                   domain="props.action.domain" resId="props.resId ?? undefined"/>
            </t>
            <p t-else="" class="o_view_error">No view can show {{ props.action.views.join(", ") }}.</p>
        </section>
    </t>
</templates>
