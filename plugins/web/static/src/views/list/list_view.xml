<templates>
    <t t-name="web.ListView">
        <div class="o_list_view">
            <div class="o_control_panel">
                <button type="button" class="o_button_primary" t-on-click="create">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    New
                </button>
                <Suspense>
                    <t t-set-slot="fallback">
                        <label class="o_search"><input type="search" aria-label="Search" placeholder="Search…" disabled=""/></label>
                    </t>
                    <SearchBar view="searchView" facets="currentFacets" onChange="setFacets"/>
                </Suspense>
                <div t-if="selected.size" class="o_list_actions">
                    <span class="o_selection_count">{{ selected.size }} selected</span>
                    <button type="button" class="o_button_secondary" t-att-disabled="running"
                            t-att-aria-expanded="actionsOpen ? 'true' : 'false'" t-on-click="() => actionsOpen = !actionsOpen">
                        Actions
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    <ul t-if="actionsOpen" class="o_list_actions_menu" role="menu">
                        <li t-foreach="actionItems" t-as="item" t-key="item.kind + ':' + item.name" role="none">
                            <button type="button" role="menuitem" t-on-click="() => act(item)">{{ item.label }}</button>
                        </li>
                    </ul>
                </div>
                <Suspense>
                    <t t-set-slot="fallback"><div class="o_pager"><span class="o_pager_value">…</span></div></t>
                    <div class="o_pager">
                        <span class="o_pager_value">{{ range }} / {{ total }}</span>
                        <button type="button" class="o_pager_button" aria-label="Previous page"
                                t-att-disabled="!hasPrevious" t-on-click="previous">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                        </button>
                        <button type="button" class="o_pager_button" aria-label="Next page"
                                t-att-disabled="!hasNext" t-on-click="next">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    </div>
                </Suspense>
            </div>
            <section class="o_list_card">
                <Suspense>
                    <t t-set-slot="fallback"><t t-call="web.Loading"/></t>
                    <table class="o_list_table">
                        <thead>
                            <tr>
                                <th class="o_list_select">
                                    <Suspense>
                                        <t t-set-slot="fallback"><input type="checkbox" aria-label="Select all rows" disabled=""/></t>
                                        <input type="checkbox" aria-label="Select all rows" t-att-checked="allSelected"
                                               t-on-change="(ev) => selectAll(ev.target.checked)"/>
                                    </Suspense>
                                </th>
                                <th t-foreach="columns" t-as="column" t-key="column.name"
                                    t-att-class="cellClass(column) + (isSortable(column) ? ' o_list_sortable' : '')"
                                    t-att-aria-sort="sortOf(column)" t-on-click="() => sortBy(column)">
                                    {{ column.label }}
                                    <svg t-if="sortOf(column) !== 'none'" class="o_list_sort" width="11" height="11" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"
                                         stroke-linejoin="round" aria-hidden="true">
                                        <path t-if="sortOf(column) === 'ascending'" d="m6 15 6-6 6 6"/>
                                        <path t-else="" d="m6 9 6 6 6-6"/>
                                    </svg>
                                </th>
                            </tr>
                        </thead>
                        <Suspense>
                            <t t-set-slot="fallback">
                                <tbody>
                                    <tr class="o_list_empty">
                                        <td t-att-colspan="columns.length + 1"><t t-call="web.Loading"/></td>
                                    </tr>
                                </tbody>
                            </t>
                            <tbody>
                                <tr t-foreach="records" t-as="record" t-key="record.id"
                                    t-att-class="{ o_list_row: true, selected: selected.has(idOf(record)) }"
                                    t-on-click="() => choose(record)">
                                    <td class="o_list_select" t-on-click.stop="() => {}">
                                        <input type="checkbox" aria-label="Select this row"
                                               t-att-checked="selected.has(idOf(record))"
                                               t-on-change="(ev) => select(record, ev.target.checked)"/>
                                    </td>
                                    <td t-foreach="columns" t-as="column" t-key="column.name"
                                        t-att-class="cellClass(column)">
                                        <t t-component="widgetFor(column)" record="record" model="props.resModel" name="column.name"
                                           field="column.field" attrs="column.attrs"/>
                                    </td>
                                </tr>
                                <tr t-if="records?.length === 0" class="o_list_empty">
                                    <td t-att-colspan="columns.length + 1">No records.</td>
                                </tr>
                            </tbody>
                        </Suspense>
                    </table>
                </Suspense>
            </section>
            <div t-if="confirming" class="o_dialog_backdrop">
                <div class="o_dialog" role="alertdialog" aria-modal="true" aria-labelledby="o_dialog_message">
                    <p id="o_dialog_message" class="o_dialog_message">{{ confirming.message }}</p>
                    <div class="o_dialog_buttons">
                        <button type="button" class="o_button_secondary" t-on-click="() => confirming = null">Cancel</button>
                        <button type="button" class="o_button_primary o_button_danger" t-on-click="confirm">{{ confirming.item.label }}</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
