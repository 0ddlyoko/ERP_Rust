<templates>
    <t t-name="web.FormView">
        <div class="o_form_view" t-on-click="(ev) => focusField(ev)">
            <Suspense>
                <t t-set-slot="fallback"><t t-call="web.Loading"/></t>
                <t t-if="body" t-component="body" form="this"/>
            </Suspense>
        </div>
    </t>
</templates>
