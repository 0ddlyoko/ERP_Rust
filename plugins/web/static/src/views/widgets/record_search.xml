<templates>
    <t t-name="web.RecordSearch">
        <div class="o_record_search">
            <svg class="o_record_search_icon" width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
            </svg>
            <input type="text" class="o_input" role="combobox" aria-autocomplete="list"
                   t-att-aria-expanded="isOpen ? 'true' : 'false'" t-att-value="inputText"
                   t-att-placeholder="props.placeholder"
                   t-on-focus="(ev) => enter(ev.target)"
                   t-on-input="(ev) => type(ev.target.value)" t-on-keydown="(ev) => key(ev)"
                   t-on-blur="close"/>
            <ul t-if="isOpen" class="o_record_search_results" role="listbox">
                <li t-foreach="choices" t-as="choice" t-key="choice[0]" role="option"
                    t-att-aria-selected="choice_index === active ? 'true' : 'false'"
                    t-att-class="{ o_record_search_result: true, active: choice_index === active }"
                    t-on-mousedown.prevent="() => pick(choice)">{{ choice[1] }}</li>
                <li t-if="searching &amp;&amp; !choices.length" class="o_record_search_note">Searching…</li>
                <li t-elif="!choices.length" class="o_record_search_note">No record found.</li>
            </ul>
        </div>
    </t>
</templates>
