<templates>
    <t t-name="web.TagsWidget">
        <div t-att-class="className + ' o_tags' + (editable ? ' o_tags_editable' : '')"
             t-on-click="(ev) => editable &amp;&amp; ev.currentTarget.querySelector('input')?.focus()">
            <span t-foreach="shownEntries" t-as="tag" t-key="tag.key" t-att-class="tagClass(tag)">
                {{ nameOf(tag) }}
                <button t-if="editable" type="button" class="o_tag_remove" t-on-click="() => remove(tag.key)"
                        t-att-aria-label="'Remove ' + nameOf(tag)">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                </button>
            </span>
            <span t-if="more" class="o_tags_more" t-att-title="text">+{{ more }} more</span>
            <RecordSearch t-if="editable" model="relation" exclude="ids" domain="domain" onPick="add" many="true" placeholder="entries.length ? '' : 'Add…'"
                          onBackspace="removeLast" keepOpen="true"
                          onCreate="canCreate ? create : undefined"
                          onCreateEdit="canCreate &amp;&amp; !isOne2Many ? createEdit : undefined"/>
            <FormDialog t-if="creating" model="relation" defaults="creating" onCreated="created" onClose="closeDialog"/>
        </div>
    </t>
</templates>
