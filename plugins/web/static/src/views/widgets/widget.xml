<templates>
    <t t-name="web.Widget">
        <input t-if="editable" t-att-type="inputType" t-att-class="className + ' o_input'"
               t-att-value="inputValue" t-on-input="(ev) => commit(ev.target.value)"/>
        <span t-else="" t-att-class="className">{{ text }}</span>
    </t>
</templates>
