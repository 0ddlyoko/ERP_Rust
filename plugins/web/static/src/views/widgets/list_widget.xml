<templates>
    <t t-name="web.ListWidget">
        <div t-att-class="className + ' o_x2many_list'">
            <table class="o_list_table">
                <thead>
                    <tr>
                        <th t-foreach="columns" t-as="column" t-key="column.name"
                            t-att-class="cellClass(column)">{{ column.label }}</th>
                        <th t-if="editable" class="o_x2many_actions"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="rows" t-as="row" t-key="row.id"
                        t-att-class="{ o_list_row: true, o_x2many_openable: openAction !== null }"
                        t-on-click="() => open(row.id)">
                        <td t-foreach="columns" t-as="column" t-key="column.name" t-att-class="cellClass(column)">
                            <t t-component="cellWidget(column)" record="row" name="column.name"
                               field="column.field" attrs="column.attrs"/>
                        </td>
                        <td t-if="editable" class="o_x2many_actions">
                            <button type="button" class="o_x2many_remove" aria-label="Remove this line"
                                    title="Remove this line" t-on-click.stop="() => remove(row.id)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M4 7h16"/><path d="M10 11v6M14 11v6"/>
                                    <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12"/><path d="M9 7V4h6v3"/>
                                </svg>
                            </button>
                        </td>
                    </tr>
                    <tr t-if="!rows.length" class="o_list_empty">
                        <td t-att-colspan="columns.length + (editable ? 1 : 0)">No records.</td>
                    </tr>
                </tbody>
            </table>
            <RecordSearch t-if="editable" model="model" exclude="ids" onPick="add" placeholder="'Add a line…'"/>
        </div>
    </t>
</templates>
