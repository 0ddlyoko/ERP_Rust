{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "types": [],
    "paths": {
      "@web/*": [
        "./plugins/web/static/src/*"
      ],
      "@test_plugin/*": [
        "./plugins/test_plugin/static/src/*"
      ]
    }
  },
  "include": [
    "plugins/*/static/**/*.ts"
  ]
}
